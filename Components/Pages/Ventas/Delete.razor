
@page "/Venta/Delete/{id:int}"
@using Williams_AP1_P2.Models
@using Williams_AP1_P2.Services
@inject VentasService VentasService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Eliminar Venta</PageTitle>

<h3 class="text-center mt-4">Eliminar Venta</h3>

<div class="container mt-4">

    @if (Cargando)
    {
        <p class="text-center">Cargando venta...</p>
    }
    else if (Venta == null)
    {
        <div class="alert alert-danger">
            @Mensaje
        </div>

        <a href="/Venta/Index" class="btn btn-secondary">
            Volver
        </a>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header bg-danger text-white">
                Confirmar eliminación
            </div>

            <div class="card-body">

                <div class="alert alert-warning d-flex align-items-center"
                     role="alert">
                    <div>
                        <strong>¿Desea eliminar esta venta?</strong>
                        <p class="mb-0">
                            Deseas Eliminar este producto
                        </p>
                    </div>
                </div>

                <p>
                    <strong>Venta ID:</strong> @Venta.VentaId
                </p>

                <p>
                    <strong>Fecha:</strong>
                    @Venta.Fecha.ToString("dd/MM/yyyy")
                </p>

                <p>
                    <strong>Observación:</strong> @Venta.Observacion
                </p>

                <h5 class="mt-4">Productos de la venta</h5>

                <div class="table-responsive">
                    <table class="table table-bordered table-striped">
                        <thead class="table-dark">
                            <tr>
                                <th>Producto</th>
                                <th>Precio</th>
                                <th>Cantidad</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var detalle in Venta.Detalles)
                            {
                                <tr>
                                    <td>@detalle.Producto?.Concepto</td>
                                    <td>@detalle.Precio.ToString("C2")</td>
                                    <td>@detalle.Cantidad</td>
                                    <td>
                                        @((detalle.Cantidad * detalle.Precio).ToString("C2"))
                                    </td>
                                </tr>
                            }
                        </tbody>

                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-end">
                                    Total:
                                </th>
                                <th>
                                    @Venta.Total.ToString("C2")
                                </th>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <div class="alert alert-danger">
                        @Mensaje
                    </div>
                }

                <div class="d-flex justify-content-end gap-2">
                    <a href="/Venta/Index" class="btn btn-secondary">
                        Cancelar
                    </a>

                    <button class="btn btn-danger" @onclick="Eliminar">
                        Confirmar eliminación
                    </button>
                </div>

            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int id { get; set; }

    private Ventas? Venta;
    private string Mensaje = string.Empty;
    private bool Cargando = true;

    protected override async Task OnInitializedAsync()
    {
        var resultado = await VentasService.Buscar(id);

        if (resultado.IsSuccess)
        {
            Venta = resultado.Value;
        }
        else
        {
            Venta = null;
            Mensaje = resultado.Error.Description;
        }

        Cargando = false;
    }

    private async Task Eliminar()
    {
        var resultado = await VentasService.Eliminar(id);

        if (resultado.IsSuccess)
        {
            Navigation.NavigateTo("/Venta/Index");
        }
        else
        {
            Mensaje = resultado.Error.Description;
        }
    }
}
